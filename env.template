        # StripeForm Environment Variables Template
        # Copy this file to .env.local and fill in your actual values

        # =============================================================================
        # FIREBASE CONFIGURATION (REQUIRED)
        # =============================================================================
        # Get these from your Firebase project console: https://console.firebase.google.com/
        NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
        NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
        NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
        NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
        NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
        NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

        # =============================================================================
        # SUPABASE CONFIGURATION (REQUIRED)
        # =============================================================================
        # Get these from your Supabase project dashboard: https://supabase.com/dashboard
        NEXT_PUBLIC_SUPABASE_URL=https://your_project.supabase.co
        NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

        # =============================================================================
        # STRIPE CONFIGURATION (REQUIRED)
        # =============================================================================
        # Get these from your Stripe dashboard: https://dashboard.stripe.com/
        NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
        STRIPE_SECRET_KEY=sk_test_your_secret_key_here
        STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

        # Stripe Price IDs for subscriptions (REQUIRED)
        NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=price_your_monthly_price_id
        NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=price_your_yearly_price_id

        # =============================================================================
        # DATABASE CONFIGURATION (REQUIRED)
        # =============================================================================
        # PostgreSQL connection string for your database
        # Format: postgresql://username:password@host:port/database_name
        DATABASE_URL=postgresql://postgres:password@localhost:5432/stripeform

        # =============================================================================
        # AUTHENTICATION CONFIGURATION (REQUIRED)
        # =============================================================================
        # Generate a random string for authentication (used for JWT tokens)
        # You can use either NEXTAUTH_SECRET or JWT_SECRET (both work)
        NEXTAUTH_SECRET=your_nextauth_secret_here
        # JWT_SECRET=your_jwt_secret_here  # Alternative to NEXTAUTH_SECRET
        NEXTAUTH_URL=http://localhost:3000

        # =============================================================================
        # DEVELOPMENT SETTINGS
        # =============================================================================
        # Uncomment for development
        # NODE_ENV=development
